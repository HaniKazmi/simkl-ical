# Register an app at https://simkl.com/settings/developer/ to get a client id.
# No client secret is required: the PIN (device) flow authenticates with the
# client id alone. A secret is only needed for the browser redirect flow.
SIMKL_CLIENT_ID=

# Secret path segment for the feed URL: openssl rand -hex 24
FEED_TOKEN=

# Set explicitly. Unset, this falls back to Europe/London, which is a guess
# about you rather than a fact — and a wrong zone puts late-evening US airings
# on the wrong day.
TZ=Europe/London

# Which country's cinema dates to use for film releases (ISO 3166-1 alpha-2).
RELEASE_COUNTRY=GB

# How long a recently-aired episode stays in the feed, in days. Not filtered by
# watch state — the calendar is a record of what aired, so nothing vanishes the
# moment it airs. Values above 2 pull monthly archives as well as the rolling
# file, so this is capped at 90.
GRACE_DAYS=14

PORT=3000
DATA_DIR=./data

# Refresh cadences, in milliseconds. The defaults are almost always right; each
# is floored at 60000 so a mistyped value cannot turn into a tight loop.
# CALENDAR_REFRESH_MS=21600000   # 6h  — re-read the airdate calendars
# ACTIVITIES_POLL_MS=1800000     # 30m — check the library for changes
# MOVIE_REFRESH_MS=86400000      # 24h — re-read film release dates, which move
#                                #       without producing any library activity

# --- Google Sheet sync (optional) ------------------------------------------
# Keeps a hand-maintained "TV Shows" spreadsheet current off the same poll that
# drives the feed. Unset SHEET_ID and none of this runs.
#
# The service account needs the spreadsheet shared with its client_email as
# Editor, and the sheet must keep its show-row roll-up formulas.
# SHEET_ID=
# SHEET_NAME=Sheet1
# The films tab. Its rules are in the TMDB block at the bottom of this file.
# MOVIES_SHEET_NAME=Movies

# Base64 of the service-account JSON: base64 -w0 sa.json  (macOS: base64 -i)
# Preferred over a path — the key is a multi-line PEM, and base64 survives
# every parser between the file and the process untouched.
# GOOGLE_SA_KEY_B64=
# GOOGLE_APPLICATION_CREDENTIALS=~/.config/plot-device/sa.json

# off / report / apply. Anything unrecognised clamps to report, never apply.
# Run report against the real sheet before granting Editor access: it plans in
# full and logs every proposed edit without writing anything.
# SHEET_SYNC_MODE=report

# Nothing is touched without watch activity this recent, with no exemptions.
# SHEET_SINCE_DAYS=90

# Circuit breakers. Over budget refuses the whole plan rather than trimming it:
# a run wanting this many cells is likelier a bug than a legitimate binge. The
# report still names every edit it wanted, so raise one for a single run rather
# than leaving it raised. New season rows are not covered by these: exactly one
# is added per run, which is a property of how the requests are built and not a
# setting.
# SHEET_MAX_EDITS=30
# SHEET_MAX_ROWS=20

# --- Per-episode runtimes (optional) ----------------------------------------
# When the sync closes a season it can also fill that row's Episodes cell with
# the season's average episode runtime, so Length stops reading zero. Only into
# a *blank* cell — a runtime you typed is never overwritten — and only on the
# run that closes the row, since a dated row is never touched again.
#
# TVDB rather than TMDb because it is what simkl.com itself shows: the two
# databases disagree by up to 5 minutes an episode on some titles, and the cell
# freezes on write. Live-action only; a SIMKL anime record numbers every cour
# "season 1", so there is nothing to match a TVDB season on.
#
# With a key set, a row the sync *adds* for a live-action season leaves that
# cell blank while the season is still *airing*, so the season's own average can
# reach it when the row closes — Length reads 0 for that row until then. Once a
# season has finished airing its lengths are settled, so a row added even one
# episode in carries the average straight away, dated or not.
#
# Unset, seasons close exactly as they do now, a new row keeps SIMKL's
# show-wide runtime, and no request is made.
# TVDB_API_KEY=
# Only a user-supported key needs a subscriber PIN; a licensed key logs in
# without one.
# TVDB_PIN=

# --- Film metadata (optional) -----------------------------------------------
# Switches on the films tab: new films get a row, and a row already there is
# revisited only where SIMKL's own facts move. Anime films count as films, and
# go here unless the show grid already has the id — the sheet's own placement is
# the only thing that answers where one belongs.
#
# Three columns follow SIMKL for the life of a row — Watch Date, Score and
# Runtime — each compared against what this service last recorded rather than
# against the cell, so a first run over a full tab writes nothing and the tab
# stays quiet until something actually changes.
#
# Ten more are written when the row is created and never revisited: Name,
# Cinema, Genre, Genres, Rating, Release Date, Franchise, Director, Banner and
# id. Eight of those come from TMDB, which is why the whole half is inert
# without a token — a row inserted with them blank is worse than no row. If one
# is wrong, correct it by hand; nothing here will write over it.
#
# TMDb here does not reverse the choice of TVDB above. That one is about
# per-episode runtimes, where TVDB wins because it is what simkl.com shows. A
# film's genres, certificate, backdrop and collection have no TVDB equivalent.
#
# This is the **v4 read access token** from TMDB's API settings, not the v3 API
# key: it goes in an Authorization header, where the v3 key's `?api_key=` would
# put the credential into paths the status page prints.
#
# Unset, the films tab is never read and the show grid is unaffected.
# TMDB_API_KEY=
