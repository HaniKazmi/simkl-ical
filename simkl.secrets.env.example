# Copy to simkl.secrets.env and fill in. Gitignored — never commit the real file.
#
# Secrets only. Non-secret configuration (TZ, RELEASE_COUNTRY, GRACE_DAYS)
# lives directly in docker-compose.yml.

# Register an app at https://simkl.com/settings/developer/
# No client secret is needed: the PIN flow authenticates with the id alone.
SIMKL_CLIENT_ID=

# Secret path segment of your feed URL. Anyone holding it can read your
# watchlist, so make it long: openssl rand -hex 24
FEED_TOKEN=

# Google service-account key for the sheet sync, base64-encoded — optional, and
# only needed alongside SHEET_ID in docker-compose.yml.
#
#   printf 'GOOGLE_SA_KEY_B64=%s\n' "$(base64 -w0 sa.json)" >> simkl.secrets.env
#   (macOS: base64 -i sa.json)
#
# Base64 because the private key is a 29-line PEM and three parsers sit between
# this file and the process — Node's --env-file, Compose's env_file, and the
# shell — which disagree about quoting, escapes and multi-line values.
# Like FEED_TOKEN, this is visible to `docker inspect`; keep the file at 0600.
# GOOGLE_SA_KEY_B64=

# TVDB v4 key for per-episode runtimes — optional, and only useful alongside
# SHEET_ID. Register at https://thetvdb.com/api-information
#
# A licensed key needs the key alone; a user-supported key also needs your
# subscriber PIN. Unset, the sync closes seasons exactly as it does without it.
# TVDB_API_KEY=
# TVDB_PIN=
